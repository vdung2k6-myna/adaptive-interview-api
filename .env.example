PORT=4000
API_AUTH_TOKEN=your-secret-api-token
DATABASE_URL=postgresql://user:password@localhost:5432/ai_interview
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=mxbai-embed-large
EMBEDDING_SIMILARITY_THRESHOLD=0.75
MCP_ENABLED=true
MCP_AUTH_TOKEN=your-mcp-secret
FRONTEND_URL=http://localhost:3000
AUDIO_STORAGE_DIR=/tmp/audio
# How long a streamed turn's per-segment audio files stay on disk after they are
# written, in ms. The client fetches a segment within seconds of the event that
# names it, so this is margin against a slow fetch, not a playback budget —
# setting it very low is how you reproduce an unretrievable segment locally.
# Default: 600000 development, 300000 production.
AUDIO_SEGMENT_RETENTION_MS=300000
AUDIOCPP_BASE_URL=http://localhost:8080
AUDIO_GATEWAY_URL=http://localhost:8082
DEFAULT_TTS_ENGINE=kokoro
DEFAULT_VOICE=default_voice
KOKORO_VOICE_ENGLISH=af_heart
# KOKORO_VOICE_VIETNAMESE=
PIPER_VOICE_ENGLISH=en_US-lessac-medium
# PIPER_VOICE_VIETNAMESE=
SUPERTONIC_VOICE_ENGLISH=default
# SUPERTONIC_VOICE_VIETNAMESE=

# Document ETL service for voice-agent knowledge retrieval
DOC_ETL_API_URL=http://localhost:8000
# Per-request timeout for POST /search, in ms. Search is in-memory and fast; a
# long timeout is paid as first-token latency on every turn while the service is down.
DOC_ETL_SEARCH_TIMEOUT_MS=1500

# Material replies: a turn for a persona in `material` mode may speak a passage
# from these collections as it is stored, instead of generating one. Unset,
# development speaks the two wiki collections and production speaks none — so a
# deployment that has not made this decision generates every reply. Setting the
# value empty is that same decision said explicitly.
# MATERIAL_COLLECTIONS=truyen-kiem-hiep,kiem-hiep
# The score a retrieved passage must reach to be spoken. Higher is stricter: too
# low speaks an off-topic passage aloud, too high generates instead. Measured
# default 0.55.
# MATERIAL_SCORE_FLOOR=0.55

# Voice Agent: soft cap on exchanges kept in the LLM context.
VOICE_AGENT_MAX_HISTORY=20
