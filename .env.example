PORT=4000
API_AUTH_TOKEN=your-secret-api-token
DATABASE_URL=postgresql://user:password@localhost:5432/ai_interview
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=mxbai-embed-large
EMBEDDING_SIMILARITY_THRESHOLD=0.75
MCP_ENABLED=true
MCP_AUTH_TOKEN=your-mcp-secret
FRONTEND_URL=http://localhost:3000
AUDIO_STORAGE_DIR=/tmp/audio
# How long a streamed turn's per-segment audio files stay on disk after they are
# written, in ms. The client fetches a segment within seconds of the event that
# names it, so this is margin against a slow fetch, not a playback budget —
# setting it very low is how you reproduce an unretrievable segment locally.
# Default: 600000 development, 300000 production.
AUDIO_SEGMENT_RETENTION_MS=300000
# The directory this deployment's music is in, left unset for a deployment with none. A turn can
# then be asked for a track and the platform answers with it; with nothing set, no music tool is
# offered to the model and turns are asked exactly as they were before any of this existed.
#
# **It has to be inside `AUDIO_STORAGE_DIR`**, because that is the one directory the audio mount
# serves and it wears the API's credential: a track elsewhere has no URL a client could fetch, so it
# is reported at boot and the library is not offered rather than served at a path that resolves to
# nothing. Read when it is asked rather than at boot, so a track dropped in while the platform runs
# is playable.
#
# **And it cannot be `AUDIO_STORAGE_DIR` itself.** The audio root holds every session's recordings
# alongside any music, and a session's recording is audio — a candidate's answer is written as
# `.wav` — so a library pointed there would offer a person's own voice as a track. Reported at boot
# and not offered, the same as a directory outside the root.
#
# The files are your own, and this repository ships no music and grants no rights to any. Holding a
# track and playing it to a listener are different rights, and an interview is heard by the person
# being interviewed — so a track played here is played to someone other than you. Serve material
# whose terms you can state. See NOTICE.
#MUSIC_LIBRARY_DIR=/tmp/audio/music
AUDIOCPP_BASE_URL=http://localhost:8080
AUDIO_GATEWAY_URL=http://localhost:8082
DEFAULT_TTS_ENGINE=piper
DEFAULT_VOICE=bryce
KOKORO_VOICE_ENGLISH=af_heart
# KOKORO_VOICE_VIETNAMESE=
PIPER_VOICE_ENGLISH=bryce
# PIPER_VOICE_VIETNAMESE=
# A Supertonic voice is the name of a style file the service holds: one of its
# ten built-ins (F1-F5, M1-M5) or a style installed alongside them. A name it
# does not hold fails the turn rather than falling back to another voice.
SUPERTONIC_VOICE_ENGLISH=F1
# SUPERTONIC_VOICE_VIETNAMESE=

# Per-engine volume: a linear multiplier applied to the audio the gateway
# returns, before anything else sees it. 1 leaves an engine as it is; below 1
# attenuates, above 1 amplifies and clamps whatever no longer fits. The engines
# do not agree on loudness — on one Vietnamese sentence kokoro and piper come back
# at full scale and supertonic ~8 dB below — so these are how they are matched.
# Measure the result with `node scripts/measure-engine-levels.mjs`.
# Defaults: 0.5 / 0.7 / 1.2.
KOKORO_VOLUME=0.5
PIPER_VOLUME=0.7
SUPERTONIC_VOLUME=1.2

# Document ETL service for voice-agent knowledge retrieval
DOC_ETL_API_URL=http://localhost:8005
# Per-request timeout for POST /search, in ms. Search is in-memory and fast; a
# long timeout is paid as first-token latency on every turn while the service is down.
DOC_ETL_SEARCH_TIMEOUT_MS=1500

# Material replies: a turn for a persona in `material` mode may speak a passage
# from these collections as it is stored, instead of generating one. Unset,
# development speaks the two wiki collections and production speaks none — so a
# deployment that has not made this decision generates every reply. Setting the
# value empty is that same decision said explicitly.
# MATERIAL_COLLECTIONS=truyen-kiem-hiep,kiem-hiep
# The score a retrieved passage must reach to be spoken. Higher is stricter: too
# low speaks an off-topic passage aloud, too high generates instead. Measured
# default 0.55.
# MATERIAL_SCORE_FLOOR=0.55

# Voice Agent: soft cap on exchanges kept in the LLM context.
VOICE_AGENT_MAX_HISTORY=20
