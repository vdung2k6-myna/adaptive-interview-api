{
  "name": "adaptive-interview-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "lint": "eslint src/",
    "test": "npx tsx --test src/**/*.test.ts",
    "test:tsx": "npx tsx --test src/**/*.test.ts",
    "db:migrate": "drizzle-kit migrate",
