# The gateway holds one address per engine. This proxy is that address: it fronts
# every replica of each engine, so adding capacity is a compose scale operation
# rather than a gateway or API change.
{
	admin off
	auto_https off
}

# Liveness only. The proxy must stay up while an engine it fronts is down — the
# gateway reports "degraded" for that case rather than refusing to run, and the
# proxy follows the same rule.
:8090 {
	respond /health "ok" 200
}

:8091 {
	reverse_proxy kokoro:8081 {
		lb_policy least_conn
		health_uri /health
		health_interval 10s
		health_timeout 5s
	}
}

:8093 {
	reverse_proxy piper:8083 {
		lb_policy least_conn
		health_uri /health
		health_interval 10s
		health_timeout 5s
	}
}

:8094 {
	reverse_proxy supertonic:8084 {
		lb_policy least_conn
		health_uri /health
		health_interval 10s
		health_timeout 5s
	}
}
